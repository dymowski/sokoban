# Host port where nginx serves the built game (make up → http://localhost:APP_PORT)
APP_PORT=8088

# Host port for the Vite dev server with HMR (make dev)
DEV_PORT=5188

# Node image for the tooling (npm, vite, vitest, eslint) — same version as .nvmrc, pinned by tag and digest
NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

# nginx image (unprivileged, port 8080 in the container) serving the dist/ directory
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86

# Playwright image for e2e tests — its version must match @playwright/test in package.json
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
